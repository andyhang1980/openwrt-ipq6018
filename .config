# =============================================================
# OpenWRT Configuration for JDCloud AX1800 Pro (IPQ6018)
# =============================================================
# Target: Qualcomm IPQ60xx (ARM64, qualcommax)
# Device: JDCloud AX1800 Pro
# Build: Based on community fork with NSS support
# =============================================================

# -----------------------------------------------------------
# Target System (Qualcomm IPQ60xx)
# -----------------------------------------------------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y

# -----------------------------------------------------------
# Target Images
# -----------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=128
CONFIG_TARGET_ROOTFS_SQUASHFS4=y
CONFIG_TARGET_UBIFS_JFFS2=y
CONFIG_TARGET_ROOTFS_INCLUDE_TAR=y

# -----------------------------------------------------------
# Target Profile - JDCloud AX1800 Pro
# -----------------------------------------------------------
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_ax1800pro=y

# -----------------------------------------------------------
# Kernel Configuration
# -----------------------------------------------------------
CONFIG_LINUX_5_4=y
CONFIG_arm64=y

# -----------------------------------------------------------
# Kernel modules - Wireless drivers
# -----------------------------------------------------------
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-qca6490=y
CONFIG_PACKAGE_ath11k-firmware-qcn9074=y

# -----------------------------------------------------------
# Kernel modules - Network drivers
# -----------------------------------------------------------
CONFIG_PACKAGE_kmod-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-ptp=y
CONFIG_PACKAGE_kmod-crypto-arc4=y
CONFIG_PACKAGE_kmod-crypto-ecb=y
CONFIG_PACKAGE_kmod-crypto-aes=y
CONFIG_PACKAGE_kmod-crypto-des=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-crypto-sha1=y
CONFIG_PACKAGE_kmod-crypto-sha256=y

# -----------------------------------------------------------
# Kernel modules - USB
# -----------------------------------------------------------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-storage=y

# -----------------------------------------------------------
# Kernel modules - Filesystem
# -----------------------------------------------------------
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-nls-common=y
CONFIG_PACKAGE_kmod-fs-nls-cp437=y
CONFIG_PACKAGE_kmod-fs-nls-iso8859-1=y

# -----------------------------------------------------------
# Kernel modules - Other
# -----------------------------------------------------------
CONFIG_PACKAGE_kmod-fs-autofs4=y
CONFIG_PACKAGE_kmod-input-core=y
CONFIG_PACKAGE_kmod-input-evdev=y
CONFIG_PACKAGE_kmod-button-hotplug=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_leds-gpio=y
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-thermal=y
CONFIG_PACKAGE_kmod-tmp421=y

# -----------------------------------------------------------
# Target - Kernel builtin
# -----------------------------------------------------------
CONFIG_UBOOT_TARGET_qualcommax_ipq60xx=y
CONFIG_PACKAGE_uboot-envtools=y

# -----------------------------------------------------------
# LuCI - Base
# -----------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-base-en=y
CONFIG_PACKAGE_luci-i18n-firewall-en=y

# -----------------------------------------------------------
# LuCI - Default Settings
# -----------------------------------------------------------
CONFIG_PACKAGE_luci-theme-bootstrap=y

# -----------------------------------------------------------
# LuCI - Applications
# -----------------------------------------------------------
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-en=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-ttyd=y

# -----------------------------------------------------------
# LuCI - Protocols
# -----------------------------------------------------------
CONFIG_PACKAGE_luci-proto-relay=y

# -----------------------------------------------------------
# Network
# -----------------------------------------------------------
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_openssh-sftp-server=y

# -----------------------------------------------------------
# Utilities
# -----------------------------------------------------------
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_zip=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_lm-sensors=y

# -----------------------------------------------------------
# Firmware
# -----------------------------------------------------------
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# -----------------------------------------------------------
# LuCI - Firewall
# -----------------------------------------------------------
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-vlmcsd=y

# -----------------------------------------------------------
# Build system
# -----------------------------------------------------------
CONFIG_DEVEL=y
CONFIG_TOOLCHAIN=y
CONFIG_EXTRA_TARGETS=""
CONFIG_DOWNLOAD_TOOLCHAIN=y
CONFIG_BUILD_LOG_DIR="logs"
